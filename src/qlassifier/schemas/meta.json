{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "description": "A typed error: ``message`` + ``hint`` are exactly the library exception's text.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "hint": {
          "title": "Hint",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "message",
        "hint",
        "status"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "MetaVersions": {
      "additionalProperties": false,
      "description": "Versions shown by the dashboard.",
      "properties": {
        "python": {
          "title": "Python",
          "type": "string"
        },
        "qiskit": {
          "title": "Qiskit",
          "type": "string"
        },
        "qiskit_aer": {
          "title": "Qiskit Aer",
          "type": "string"
        },
        "qiskit_ibm_runtime": {
          "title": "Qiskit Ibm Runtime",
          "type": "string"
        },
        "scikit_learn": {
          "title": "Scikit Learn",
          "type": "string"
        },
        "numpy": {
          "title": "Numpy",
          "type": "string"
        }
      },
      "required": [
        "python",
        "qiskit",
        "qiskit_aer",
        "qiskit_ibm_runtime",
        "scikit_learn",
        "numpy"
      ],
      "title": "MetaVersions",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "A dashboard benchmark run (one at a time).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "array"
        },
        "status": {
          "enum": [
            "running",
            "cancelling",
            "complete",
            "cancelled",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "done": {
          "title": "Done",
          "type": "integer"
        },
        "total": {
          "description": "seeds × models + 1 cost task.",
          "title": "Total",
          "type": "integer"
        },
        "eta_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Eta S"
        },
        "started_at": {
          "description": "ISO 8601 UTC.",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorBody"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "dataset",
        "seeds",
        "status",
        "done",
        "total",
        "eta_s",
        "started_at",
        "finished_at",
        "error"
      ],
      "title": "Run",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``GET /api/v1/meta``: versions, defaults and the active run (for reattach after reload).",
  "properties": {
    "api_version": {
      "const": "1",
      "title": "Api Version",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "qlassifier": {
      "title": "Qlassifier",
      "type": "string"
    },
    "versions": {
      "$ref": "#/$defs/MetaVersions"
    },
    "default_dataset": {
      "title": "Default Dataset",
      "type": "string"
    },
    "run_seeds": {
      "title": "Run Seeds",
      "type": "integer"
    },
    "active_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/Run"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "api_version",
    "schema_version",
    "qlassifier",
    "versions",
    "default_dataset",
    "run_seeds",
    "active_run"
  ],
  "title": "Meta",
  "type": "object",
  "$id": "qlassifier/api/v1/meta.json"
}
